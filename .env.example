# Copy to .env to override the local-development defaults (all optional).
# Real environment variables take precedence over .env.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DATABASE_URL=postgresql+psycopg://feed:feed@localhost:5432/feed
POST_CREATED_TOPIC=post-created
FANOUT_GROUP_ID=fanout-workers
LOG_LEVEL=INFO

# Each user's posting limit: this many posts in a row, then this many a minute (429 beyond).
POSTS_BURST=10
POSTS_PER_MINUTE=10
