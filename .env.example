# Local development, for running the app outside Docker: cp .env.example .env
# Real environment variables take precedence over .env.

# dev: allows the local database default and the dev signing key. Never set it in production,
# where DATABASE_URL is required and tokens are verified through AUTH_JWKS_URL.
ENVIRONMENT=dev
# Made by: uv run python -m feed_fanout.devtools keys --dir .dev-keys
AUTH_DEV_PUBLIC_KEY_FILE=.dev-keys/public.pem

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DATABASE_URL=postgresql+psycopg://feed:feed@localhost:5432/feed
POST_CREATED_TOPIC=post-created
FANOUT_GROUP_ID=fanout-workers
LOG_LEVEL=INFO

# Each user's posting limit: this many posts in a row, then this many a minute (429 beyond).
POSTS_BURST=10
POSTS_PER_MINUTE=10
