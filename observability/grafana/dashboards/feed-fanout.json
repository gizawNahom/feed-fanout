        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Filter the 'One post' logs panel to one post"
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service",
          "stream": "",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(service)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": [
            "All"
          ],
          "value": [
