    {
      "id": 19,
      "type": "logs",
      "title": "One post, across every service",
      "description": "Paste a post_id into the box at the top: every log line about that post, from the API, the relay and the workers.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{project=~\"feed-fanout.*\", service=~\"api|relay|worker\"} |= \"$post_id\" | json",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
